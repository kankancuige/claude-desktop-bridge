PORT=3456
# 可选：Claude Code 可执行文件绝对路径；留空时自动检测
CLAUDE_EXE=
ANTHROPIC_API_KEY=sk-your-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro
# 独立启动 Gateway 且需要读取已有加密配置时设置。必须是 32 字节密钥的 64 位 hex 或 base64。
# BRIDGE_SECURE_PAYLOAD_KEY=
# 日志级别: trace | debug | info | warn | error | fatal (默认: info)
LOG_LEVEL=info
# 单日志文件最大体积: 10k / 10m / 1g (默认: 10m)
LOG_MAX_SIZE=10m
# 日志保留天数 (默认: 30)
LOG_RETAIN_DAYS=30
# PostgreSQL 结构化主库连接配置位于 BRIDGE_HOME/storage-config.json。
# 默认 BRIDGE_HOME=%USERPROFILE%/.claude-desktop-bridge；文件缺失或无效时 Gateway 拒绝启动。
# 环境变量可作为显式覆盖（适合一次性诊断），覆盖值仍会经过同一套本机 PostgreSQL 校验。
# 示例文件内容：
# {
#   "backend": "postgres",
#   "postgres": {
#     "connectionString": "postgresql://postgres:<password>@127.0.0.1:5432/postgres",
#     "schema": "bridge",
#     "statementTimeoutMs": 3000
#   },
#   "memory": {
#     "embeddingDimensions": 1536,
#     "embeddingEndpoint": "",
#     "embeddingApiKey": "",
#     "embeddingModel": "text-embedding-3-small"
#   }
# }
# 一次性环境覆盖：BRIDGE_STORAGE_BACKEND、BRIDGE_POSTGRES_URL、BRIDGE_POSTGRES_SCHEMA、BRIDGE_POSTGRES_STATEMENT_TIMEOUT_MS
# Memory 覆盖：BRIDGE_MEMORY_EMBEDDING_ENDPOINT、BRIDGE_MEMORY_EMBEDDING_API_KEY、BRIDGE_MEMORY_EMBEDDING_MODEL、BRIDGE_MEMORY_EMBEDDING_DIMENSIONS
